{
  "name": "zama-confidential-pooltogether-spikes",
  "version": "0.0.0",
  "private": true,
  "description": "Disposable technical validation harnesses; not production application code.",
  "scripts": {
    "compile:draw": "hardhat --config encrypted-draw/hardhat.config.ts compile",
    "test:draw": "hardhat --config encrypted-draw/hardhat.config.ts test",
    "test:draw:oracle": "hardhat --config encrypted-draw/hardhat.config.ts test encrypted-draw/test/oracle.test.ts",
    "test:draw:fhe": "hardhat --config encrypted-draw/hardhat.config.ts test encrypted-draw/test/EncryptedWeightedDraw.test.ts",
    "test:draw:gas": "REPORT_GAS=true hardhat --config encrypted-draw/hardhat.config.ts test",
    "compile:winner-acl": "hardhat --config winner-acl/hardhat.config.ts compile",
    "test:winner-acl": "hardhat --config winner-acl/hardhat.config.ts test",
    "compile:vrf": "hardhat --config chainlink-vrf/hardhat.config.ts compile",
    "test:vrf": "hardhat --config chainlink-vrf/hardhat.config.ts test",
    "compile:asset-yield": "hardhat --config confidential-asset-yield/hardhat.config.ts compile",
    "test:asset-yield": "hardhat --config confidential-asset-yield/hardhat.config.ts test",
    "compile:withdrawal": "hardhat --config withdrawal-settlement/hardhat.config.ts compile",
    "test:withdrawal": "hardhat --config withdrawal-settlement/hardhat.config.ts test"
  },
  "dependencies": {
    "@fhevm/mock-utils": "0.4.2",
    "@fhevm/solidity": "0.11.1",
    "@openzeppelin/confidential-contracts": "0.4.0",
    "@openzeppelin/contracts": "5.6.1",
    "encrypted-types": "0.0.4"
  },
  "devDependencies": {
    "@fhevm/hardhat-plugin": "0.4.2",
    "@nomicfoundation/hardhat-chai-matchers": "2.1.0",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "20.19.30",
    "@zama-fhe/relayer-sdk": "0.4.1",
    "chai": "4.5.0",
    "ethers": "6.16.0",
    "hardhat": "2.28.6",
    "hardhat-gas-reporter": "2.3.0",
    "mocha": "11.7.5",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.2.2"
}

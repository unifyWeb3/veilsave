        "selector": "JSXOpeningElement[name.name='EvidenceRow'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:hash|address|handle|plain)$/]",
        "message": "<EvidenceRow> kind must be one of 'hash' | 'address' | 'handle' | 'plain'."

{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/confidential/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/protocol/**",
              "components/shell/**",
              "ui_kits/console/**",
              "ui_kits/site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Instrument Sans|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Instrument Sans, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActivityItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|title|epoch|time|hash|status|local|style|key|ref|className|style|children)$/]",
        "message": "<ActivityItem> doesn't accept that prop. Declared props: kind, title, epoch, time, hash, status, local, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AmountField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|label|unit|max|maxLabel|onMax|error|helper|disabled|autoFocus|id|style|key|ref|className|style|children)$/]",
        "message": "<AmountField> doesn't accept that prop. Declared props: value, onChange, label, unit, max, maxLabel, onMax, error, helper, disabled, autoFocus, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|mono|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, icon, mono, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|size|icon|iconAfter|block|busy|disabled|type|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, tone, size, icon, iconAfter, block, busy, disabled, type, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|pad|interactive|as|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, tone, pad, interactive, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfidentialValue'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|value|unit|size|label|note|hideActions|onReveal|onHide|onRetry|style|key|ref|className|style|children)$/]",
        "message": "<ConfidentialValue> doesn't accept that prop. Declared props: state, value, unit, size, label, note, hideActions, onReveal, onHide, onRetry, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfidentialValue'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:row|md|lg|xl)$/]",
        "message": "<ConfidentialValue> size must be one of 'row' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|badge|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: id, label, icon, badge."
